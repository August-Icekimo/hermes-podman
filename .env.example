# LINE Messaging API credentials
# 從 https://developers.line.biz/console/ > 你的 channel > Messaging API 取得
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Optional LINE settings
# LINE_PORT=8646
LINE_HOME_CHANNEL=          # 主要對話對象的 chat id（user / group / room）
LINE_ALLOWED_USERS=         # 逗號分隔的 LINE user id 白名單

# LLM provider：OpenAI Codex（ChatGPT Plus 訂閱，OAuth），不走這個檔案。
# OAuth 憑證無法放進 .env，佈署完要在 VM 內手動登入一次（裝置碼流程，免瀏覽器）：
#   ./vm/ssh.sh        # 進 VM 後執行：
#   hermes auth add openai-codex --type oauth --no-browser
#   hermes config set model.provider openai-codex
#   hermes config set model.default gpt-6-sol
# 帳號要先在 ChatGPT 安全性設定啟用「Codex 裝置代碼登入」。
# Plus 走 Codex 只能用 gpt-6-* / gpt-5.6-*；gpt-5.5、gpt-5.4* 會回 400 並把憑證標成
# exhausted，之後連 auxiliary 任務都拿不到 token —— 用 `hermes auth reset openai-codex` 解除。
#
# 舊的 NVIDIA provider（金鑰已過期，2026-10-26 停用）：
# NVIDIA_API_KEY=

# Telegram Bot
# 從 @BotFather (https://t.me/BotFather) 取得
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=     # 逗號分隔的 Telegram user id 白名單
TELEGRAM_HOME_CHANNEL=      # 主要對話對象的 chat id
